<domain type='kvm'>
<name>mcp-pentest-vm</name>
<memory unit='GiB'>4</memory>
<vcpu placement='static'>2</vcpu>
<os>
    <type ubuntu='x86_64' machine='pc-q35-7.2'>hvm</type>
    <boot dev='hd' />
</os>
<features>
    <devices>
        <disk type='file' device='disk'>
            <driver name='qemu' type='qcow2' />
            <source file='/var/lib/mcp-orchestrator/instances/session-active.qcow2'/>
            <target dev='vda' bus='virtio'/>
        </disk>

        <interface type='network'>
            <source network='default'/>
            <model type='virtio'/>
        </interface>

        <graphics type='spice' port='5900' autoport='yes' listen='127.0.0.1'>
            <listen type='address' address='127.0.0.1'/>
        </graphics>

        <video>
            <model type='qxl' vram='65536' heads='1'/>
        </video>

        <channel type='spicevmc'>
            <target type='virtio' name='com.redhat.spice.0'/>
        </channel>

        <channel type='unix'>
            <source model='bind' path='/tmp/mcp-guest-agent.sock'/>
            <target type='virtio' name='org.mcp.guest_agent.0'/>
        </channel>
    </devices>
</features>
</domain>